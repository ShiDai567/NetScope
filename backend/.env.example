# =====================================================================
# NetScope 后端配置（复制为 .env 后按需修改）
# 全部变量含义见 doc/backend-design.md §16
# =====================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:3000

# ---- 存储（现有基础设施）----
REDIS_URL=redis://:CHANGE-ME@172.21.0.104:6379/0
DATABASE_URL=postgres://USER:PASSWORD@172.21.0.106:5432/netscope

# ---- 数据源：ikuai | mock ----
DATA_SOURCE=mock
RUN_COLLECTOR_IN_PROCESS=1
MOCK_SCENARIO=mixed

# ---- iKuai ----
IKUAI_ROUTER_URL=http://10.1.1.1
IKUAI_USERNAME=admin
IKUAI_PASSWORD=
IKUAI_TERMINAL_POLL_INTERVAL=10
IKUAI_CONN_POLL_INTERVAL=5
IKUAI_SYSTEM_POLL_INTERVAL=5
IKUAI_WAN_POLL_INTERVAL=300
IKUAI_REQUEST_TIMEOUT=8

# ---- 网络/拓扑 ----
LISTEN_PORTS=22,80,443,445,8080,8443,5001
GATEWAY_IP=
# 核心服务器定位：域名或 IP（后端 DNS 解析 + GeoIP），留空则自动用 WAN 出口定位
SERVER_LOCATION=
# 显式经纬度（最高优先级，填写后忽略 SERVER_LOCATION）
SERVER_LAT=
SERVER_LNG=

# ---- Geo ----
GEO_PROVIDER=maxmind
GEO_MAXMIND_CITY_DB=
GEO_CACHE_TTL=604800

# ---- 实时层 ----
PACKET_BUFFER_MAX=10000
STATS_WINDOWS=5,30,60,300,900,3600
BROADCAST_INTERVAL_MS=400
FLOW_PERSIST=0
SNAPSHOT_RETENTION_DAYS=30
FLOW_RECORD_RETENTION_DAYS=7

# ---- 日志 ----
LOG_LEVEL=INFO
